VOICE_CENTER_HOST=127.0.0.1
VOICE_CENTER_PORT=8891
VOICE_CENTER_DATA_DIR=./data
VOICE_CENTER_INTEGRATION_CONFIG=/absolute/path/to/voice-center/config/settings.json
VOICE_CENTER_CONTROL_WS_URL=ws://127.0.0.1:8792
VOICE_CENTER_CONTROL_WS_TOKEN_FILE=/absolute/private/path/control-ws.token
VOICE_CENTER_CHAT_URL=https://api.deepseek.com/v1
VOICE_CENTER_CHAT_MODEL=deepseek-flash
VOICE_CENTER_CHAT_API_KEY_FILE=/absolute/private/path/chat-api-key
VOICE_CENTER_CHAT_TIMEOUT_MS=60000
VOICE_CENTER_AUDIO_SERVICE_URL=http://127.0.0.1:48088
VOICE_CENTER_AUDIO_TIMEOUT_MS=20000
VOICE_CENTER_TICKET_SECRET_FILE=/absolute/private/path/voice-ticket-secret
VOICE_CENTER_BACKEND_PORT=48088
VOICE_CENTER_RUNTIME_PYTHON=/absolute/path/to/voice-center/.local/runtime-venv/bin/python
VOICE_CENTER_WORK_MODE=none
VOICE_CENTER_ASR_PROTOCOL=qwen-mlx-http
VOICE_CENTER_ASR_URL=http://127.0.0.1:48085/v1
VOICE_CENTER_ASR_MODEL=qwen3-asr
VOICE_CENTER_ASR_API_KEY_FILE=/absolute/private/path/asr-api-key
VOICE_CENTER_TTS_URL=http://127.0.0.1:48084/v1
VOICE_CENTER_TTS_MODEL=qwen3-tts
VOICE_CENTER_TTS_VOICE=Vivian
VOICE_CENTER_TTS_SAMPLE_RATE=24000
VOICE_CENTER_TTS_API_KEY_FILE=/absolute/private/path/tts-api-key
VOICE_CENTER_LLM_URL=https://api.deepseek.com/v1
VOICE_CENTER_LLM_MODEL=deepseek-flash
VOICE_CENTER_LLM_API_KEY_FILE=/absolute/private/path/llm-api-key
VOICE_CENTER_TENANT=0
VOICE_CENTER_USER=1
VOICE_CENTER_DEVICE=1
VOICE_CENTER_LLM_UPSTREAM_URL=https://api.deepseek.com/v1/chat/completions
VOICE_CENTER_LLM_UPSTREAM_API_KEY_FILE=/absolute/private/path/llm-api-key
VOICE_CENTER_LLM_TIMEOUT_MS=120000
VOICE_CENTER_SEARCH_URL=http://127.0.0.1:48082/internal/v1/agent/chat/stream
VOICE_CENTER_SEARCH_TOKEN_FILE=/absolute/private/path/search-token
VOICE_CENTER_SEARCH_TIMEOUT_MS=120000
