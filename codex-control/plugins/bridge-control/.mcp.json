{
  "mcpServers": {
    "bridge_control": {
      "command": "./scripts/launch",
      "cwd": ".",
      "args": ["--profile", "work-reporter"],
      "enabled": false,
      "startup_timeout_sec": 20,
      "tool_timeout_sec": 240,
      "env_vars": [
        "BRIDGE_CONTROL_PROFILE",
        "BRIDGE_CONTROL_DEV",
        "BRIDGE_CONTROL_HUB_MODULE",
        "BRIDGE_HUB_BASE_URL",
        "BRIDGE_HUB_CREDENTIAL_FILE",
        "PATH"
      ]
    }
  }
}
