VOICE_CONTROL_HOST=127.0.0.1
VOICE_CONTROL_PORT=8791
VOICE_CONTROL_DATA_DIR=./data
VOICE_CONTROL_INTEGRATION_CONFIG=/absolute/path/to/voice-control/config/settings.json
VOICE_CONTROL_CONTROL_WS_URL=ws://127.0.0.1:8792
VOICE_CONTROL_CONTROL_WS_TOKEN_FILE=/absolute/private/path/control-ws.token
VOICE_CONTROL_CHAT_URL=https://api.deepseek.com/v1
VOICE_CONTROL_CHAT_MODEL=deepseek-flash
VOICE_CONTROL_CHAT_API_KEY_FILE=/absolute/private/path/chat-api-key
VOICE_CONTROL_CHAT_TIMEOUT_MS=60000
VOICE_CONTROL_AUDIO_SERVICE_URL=http://127.0.0.1:48083
VOICE_CONTROL_AUDIO_TIMEOUT_MS=20000
VOICE_CONTROL_TICKET_SECRET_FILE=/absolute/private/path/voice-ticket-secret
VOICE_CONTROL_TENANT=0
VOICE_CONTROL_USER=1
VOICE_CONTROL_DEVICE=1
VOICE_CONTROL_LLM_UPSTREAM_URL=https://api.deepseek.com/v1/chat/completions
VOICE_CONTROL_LLM_UPSTREAM_API_KEY_FILE=/absolute/private/path/llm-api-key
VOICE_CONTROL_LLM_TIMEOUT_MS=120000
VOICE_CONTROL_SEARCH_URL=http://127.0.0.1:48082/internal/v1/agent/chat/stream
VOICE_CONTROL_SEARCH_TOKEN_FILE=/absolute/private/path/search-token
VOICE_CONTROL_SEARCH_TIMEOUT_MS=120000
