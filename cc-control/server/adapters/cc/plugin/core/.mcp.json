{
  "mcpServers": {
    "awf-state": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/mcp/awf-state/server.cjs"
      ]
    },
    "awf-session": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/mcp/awf-session/server.cjs"
      ],
      "env": {
        "AWF_BASE": "http://127.0.0.1:8787"
      }
    },
    "awf-oneshot": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/mcp/awf-oneshot/server.cjs"
      ]
    }
  }
}
