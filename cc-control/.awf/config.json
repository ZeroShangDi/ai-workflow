{
  "run": {
    "decision": {
      "enabled": true
    },
    "dynamicPlanning": {
      "mode": "approve_then_apply",
      "extensions": {}
    },
    "agents": {
      "max": 1,
      "maxModules": 1,
      "maxPerModule": 1,
      "maxPerFeature": 1
    }
  },
  "docs": {
    "enabled": true,
    "types": ["feature", "test", "log", "bug", "issue", "decision", "reuse", "changelog"],
    "reports": ["test", "review", "perf"]
  }
}
