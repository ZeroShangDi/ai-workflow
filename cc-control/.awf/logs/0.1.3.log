│   └── awf-oneshot/server.cjs # 1 tool：spawn claude -p
├── prompts/run/              # 8 个阶段 prompt 模板（dev/commit/debug/docs/finish/review/test/state-machine）
└── templates/awf/            # init 骨架模板
plugin/
